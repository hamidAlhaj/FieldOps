generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  ADMIN
  DISPATCHER
  TECHNICIAN
  CUSTOMER
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

enum WorkOrderPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum WorkOrderStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  VERIFIED
  CLOSED
  CANCELLED
}

enum RequestStatus {
  SUBMITTED
  ACCEPTED
  RESOLVED
  CANCELLED
}

enum AssignmentStatus {
  ACTIVE
  COMPLETED
  REASSIGNED
  CANCELLED
}

enum PhotoKind {
  BEFORE
  AFTER
}

enum NotificationType {
  ASSIGNMENT
  STATUS_CHANGE
  SYSTEM
}

model Organization {
  id              String                     @id @default(uuid()) @db.Uuid
  name            String                     @db.VarChar(160)
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  memberships     Membership[]
  technicians     TechnicianProfile[]
  customers       CustomerProfile[]
  teams           Team[]
  teamMembers     TeamMember[]
  requests        MaintenanceRequest[]
  workOrders      WorkOrder[]
  assignments     Assignment[]
  history         WorkOrderStatusHistory[]
  locations       TechnicianLocationUpdate[]
  trackingSessions TrackingSession[]
  attachments     Attachment[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  progressUpdates ProgressUpdate[]
  photoContents   PhotoContent[]
  outboxEvents    OutboxEvent[]
}

model User {
  theme String @default("light") @db.VarChar(5)
  notifyAssignments Boolean @default(true)
  notifyStatusUpdates Boolean @default(true)
  id           String        @id @default(uuid()) @db.Uuid
  passwordHash String?
  sessions     AuthSession[]
  email        String        @unique @db.VarChar(254)
  displayName  String        @db.VarChar(160)
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  memberships  Membership[]
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  name        RoleName     @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  memberships Membership[]
}

model Membership {
  id               String                   @id @default(uuid()) @db.Uuid
  organizationId   String                   @db.Uuid
  userId           String                   @db.Uuid
  roleId           String                   @db.Uuid
  status           MembershipStatus         @default(ACTIVE)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user             User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  role             Role                     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  technician       TechnicianProfile?
  customer         CustomerProfile?
  teamMembers      TeamMember[]
  assignedBy       Assignment[]             @relation("AssignedBy")
  statusChanges    WorkOrderStatusHistory[]
  uploads          Attachment[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  reviewedRequests MaintenanceRequest[]     @relation("RequestReviewer")
  progressUpdates  ProgressUpdate[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId, status])
  @@index([roleId])
}

model TechnicianProfile {
  id             String                     @id @default(uuid()) @db.Uuid
  organizationId String                     @db.Uuid
  membershipId   String                     @unique @db.Uuid
  employeeCode   String                     @db.VarChar(40)
  phone          String?                    @db.VarChar(32)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership     Membership                 @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)
  assignments    Assignment[]
  trackingSessions TrackingSession[]
  locations      TechnicianLocationUpdate[]

  @@unique([organizationId, id])
  @@unique([organizationId, employeeCode])
  @@unique([organizationId, membershipId])
}

model CustomerProfile {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  membershipId   String               @unique @db.Uuid
  phone          String?              @db.VarChar(32)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  membership     Membership           @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)
  requests       MaintenanceRequest[]

  @@unique([organizationId, membershipId])
  @@unique([organizationId, id])
}

model Team {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String       @db.VarChar(120)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  members        TeamMember[]
  workOrders     WorkOrder[]

  @@unique([organizationId, id])
  @@unique([organizationId, name])
}

model TeamMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  teamId         String       @db.Uuid
  membershipId   String       @db.Uuid
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  team           Team         @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Restrict)
  membership     Membership   @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, teamId, membershipId])
  @@index([organizationId, membershipId])
}

model MaintenanceRequest {
  version            Int             @default(0)
  reviewedAt         DateTime?
  reviewNotes        String?
  reviewedById       String?         @db.Uuid
  reviewedBy         Membership?     @relation("RequestReviewer", fields: [organizationId, reviewedById], references: [organizationId, id], onDelete: Restrict)
  id                 String          @id @default(uuid()) @db.Uuid
  organizationId     String          @db.Uuid
  customerId         String          @db.Uuid
  title              String          @db.VarChar(200)
  description        String
  address            String          @db.VarChar(500)
  latitude           Decimal?        @db.Decimal(9, 6)
  longitude          Decimal?        @db.Decimal(9, 6)
  status             RequestStatus   @default(SUBMITTED)
  cancellationReason String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer           CustomerProfile @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  workOrders         WorkOrder[]
  attachments        Attachment[]

  @@unique([organizationId, id])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, customerId])
  @@index([organizationId, reviewedById])
}

model WorkOrder {
  progress           Int                      @default(0)
  completionNotes    String?
  progressUpdates    ProgressUpdate[]
  id                 String                   @id @default(uuid()) @db.Uuid
  organizationId     String                   @db.Uuid
  requestId          String                   @db.Uuid
  teamId             String?                  @db.Uuid
  title              String                   @db.VarChar(200)
  description        String
  priority           WorkOrderPriority        @default(MEDIUM)
  status             WorkOrderStatus          @default(OPEN)
  scheduledAt        DateTime?
  completedAt        DateTime?
  verifiedAt         DateTime?
  closedAt           DateTime?
  cancellationReason String?
  version            Int                      @default(0)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  request            MaintenanceRequest       @relation(fields: [organizationId, requestId], references: [organizationId, id], onDelete: Restrict)
  team               Team?                    @relation(fields: [organizationId, teamId], references: [organizationId, id], onDelete: Restrict)
  assignments        Assignment[]
  trackingSessions   TrackingSession[]
  statusHistory      WorkOrderStatusHistory[]
  attachments        Attachment[]

  @@unique([organizationId, id])
  @@index([organizationId, status, priority, scheduledAt])
  @@index([organizationId, requestId])
  @@index([organizationId, teamId])
}

model Assignment {
  acceptedAt      DateTime?
  attachments     Attachment[]
  progressUpdates ProgressUpdate[]
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @db.Uuid
  workOrderId     String            @db.Uuid
  technicianId    String            @db.Uuid
  assignedById    String            @db.Uuid
  status          AssignmentStatus  @default(ACTIVE)
  endedAt         DateTime?
  reason          String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workOrder       WorkOrder         @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Restrict)
  technician      TechnicianProfile @relation(fields: [organizationId, technicianId], references: [organizationId, id], onDelete: Restrict)
  assignedBy      Membership        @relation("AssignedBy", fields: [organizationId, assignedById], references: [organizationId, id], onDelete: Restrict)
  trackingSessions TrackingSession[]

  @@unique([organizationId, id])
  @@unique([organizationId, id, workOrderId], map: "Assignment_order_identity")
  @@unique([organizationId, id, workOrderId, technicianId], map: "Assignment_tracking_identity")
  @@index([organizationId, workOrderId, createdAt])
  @@index([organizationId, technicianId, status])
  @@index([organizationId, assignedById])
}

model WorkOrderStatusHistory {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  workOrderId    String           @db.Uuid
  changedById    String           @db.Uuid
  fromStatus     WorkOrderStatus?
  toStatus       WorkOrderStatus
  reason         String?
  createdAt      DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workOrder      WorkOrder        @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Restrict)
  changedBy      Membership       @relation(fields: [organizationId, changedById], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, workOrderId, createdAt])
  @@index([organizationId, changedById])
}

model TechnicianLocationUpdate {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  technicianId   String            @db.Uuid
  latitude       Decimal           @db.Decimal(9, 6)
  longitude      Decimal           @db.Decimal(9, 6)
  accuracyMeters Float?
  recordedAt     DateTime
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict, map: "TrackingSession_workOrder_fkey")
  technician     TechnicianProfile @relation(fields: [organizationId, technicianId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, technicianId, recordedAt(sort: Desc)])
}


model TrackingSession {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  assignmentId   String             @db.Uuid
  workOrderId    String             @db.Uuid
  technicianId   String             @db.Uuid
  consentedAt    DateTime           @default(now())
  expiresAt      DateTime
  endedAt        DateTime?
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?
  recordedAt     DateTime?
  receivedAt     DateTime?
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  assignment     Assignment         @relation(fields: [organizationId, assignmentId, workOrderId, technicianId], references: [organizationId, id, workOrderId, technicianId], onDelete: Restrict, onUpdate: NoAction, map: "TrackingSession_assignment_fkey")
  workOrder      WorkOrder          @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Restrict)
  technician     TechnicianProfile  @relation(fields: [organizationId, technicianId], references: [organizationId, id], onDelete: Restrict, map: "TrackingSession_technician_fkey")

  @@unique([organizationId, id])
  @@index([organizationId, technicianId, endedAt])
  @@index([organizationId, workOrderId, endedAt])
  @@index([expiresAt, endedAt])
}

model Attachment {
  kind           PhotoKind?
  assignmentId   String?             @db.Uuid
  assignment     Assignment?         @relation(fields: [organizationId, assignmentId, workOrderId], references: [organizationId, id, workOrderId], onDelete: NoAction, onUpdate: NoAction, map: "Photo_assignment_order")
  content        PhotoContent?
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  requestId      String?             @db.Uuid
  workOrderId    String?             @db.Uuid
  uploadedById   String              @db.Uuid
  storageKey     String              @unique @db.VarChar(500)
  fileName       String              @db.VarChar(255)
  mimeType       String              @db.VarChar(120)
  sizeBytes      Int
  createdAt      DateTime            @default(now())
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  request        MaintenanceRequest? @relation(fields: [organizationId, requestId], references: [organizationId, id], onDelete: Restrict)
  workOrder      WorkOrder?          @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Restrict)
  uploadedBy     Membership          @relation(fields: [organizationId, uploadedById], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, requestId])
  @@index([organizationId, workOrderId])
  @@index([organizationId, uploadedById])
  @@index([organizationId, assignmentId, kind])
}

model Notification {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  recipientId    String           @db.Uuid
  type           NotificationType
  title          String           @db.VarChar(200)
  body           String
  readAt         DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recipient      Membership       @relation(fields: [organizationId, recipientId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, recipientId, readAt, createdAt])
}

model AuditLog {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  actorId        String       @db.Uuid
  action         String       @db.VarChar(120)
  entityType     String       @db.VarChar(80)
  entityId       String       @db.Uuid
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor          Membership   @relation(fields: [organizationId, actorId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId, actorId, createdAt])
}

model AuthSession {
  id            String         @id @default(uuid()) @db.Uuid
  userId        String         @db.Uuid
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
}

model RefreshToken {
  id         String      @id @default(uuid()) @db.Uuid
  sessionId  String      @db.Uuid
  tokenHash  String      @unique @db.Char(64)
  consumedAt DateTime?
  createdAt  DateTime    @default(now())
  session    AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model ProgressUpdate {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  workOrderId    String       @db.Uuid
  assignmentId   String       @db.Uuid
  authorId       String       @db.Uuid
  percent        Int
  note           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workOrder      WorkOrder    @relation(fields: [organizationId, workOrderId], references: [organizationId, id], onDelete: Restrict)
  assignment     Assignment   @relation(fields: [organizationId, assignmentId, workOrderId], references: [organizationId, id, workOrderId], onDelete: NoAction, onUpdate: NoAction, map: "Progress_assignment_order")
  author         Membership   @relation(fields: [organizationId, authorId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, workOrderId, createdAt])
  @@index([organizationId, assignmentId])
  @@index([organizationId, authorId])
}

model PhotoContent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  attachmentId   String       @unique @db.Uuid
  bytes          Bytes
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  attachment     Attachment   @relation(fields: [organizationId, attachmentId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, attachmentId])
}

model OutboxEvent {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  aggregateType  String       @db.VarChar(40)
  aggregateId    String       @db.Uuid
  eventType      String       @db.VarChar(80)
  version        Int?
  createdAt      DateTime     @default(now())
  publishedAt    DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([publishedAt, createdAt])
  @@index([organizationId, aggregateType, aggregateId])
}
